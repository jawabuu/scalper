server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Proxy API calls to the scalper container (upstream configurable so the same
    # UI image can front either the live-breakout or testnet-pullback instance).
    location /api/ {
        proxy_pass         http://${SCALPER_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_read_timeout 10s;
    }

    location /auth/ {
        proxy_pass         http://${SCALPER_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_read_timeout 10s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
