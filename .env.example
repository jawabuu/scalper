# ── COPY THIS TO .env AND FILL IN YOUR VALUES ──────────────────────────────
# Never commit .env to git — it is in .gitignore

# ── GitHub OAuth ────────────────────────────────────────────────────────────
# Required for dashboard authentication.
# Create a GitHub App at https://github.com/settings/apps
#   - Set callback URL to: https://scalper.yourdomain.com/auth/callback
#   - Permissions: Account > Email addresses (read-only)
GITHUB_CLIENT_ID=your_github_app_client_id
GITHUB_CLIENT_SECRET=your_github_app_client_secret

# Comma-separated GitHub usernames allowed to access the dashboard
AUTHORIZED_USERS=yourgithubusername

# Random secret for signing session cookies — generate once and keep secret:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=generate_a_random_string_here

# Public URL of your dashboard (no trailing slash)
APP_URL=https://scalper.yourdomain.com


# ── Short entry confirmation ────────────────────────────────────────────────
# A short used to qualify on RSI alone plus an EMA gap test that a strong
# uptrend passes by construction, so nothing confirmed the move was turning.
# G/USDT 2026-09-18 07:59 was shorted with the high still being made on the
# CURRENT bar and lost 30% ROI. This is the mirror of AUTO_LONG_REQUIRE_TURN:
# the extreme must be behind us before the short is taken. Entry volume will
# fall — watch the `no_turn` refusal counter.
AUTO_SHORT_REQUIRE_TURN=true
# EMA9 must also be falling back toward EMA21. Off by default: G already
# passed this one, and enabling two screens at once makes the run
# unattributable.
AUTO_SHORT_REQUIRE_CONVERGENCE=false

# ── Instrument classes the futures scan will trade ──────────────────────────
# By Binance exchangeInfo `underlyingType`. Crypto perps are COIN; TradFi
# perps (tokenised equities) are a different class and return -4411 on entry.
# Empty = no filtering. FAILS OPEN: a symbol with no underlyingType is allowed
# through, so this can never silently empty the universe.
# The scanner logs the class inventory once per process — read that line
# before changing this.
SCAN_ALLOWED_UNDERLYING=COIN

# ── Symbols the futures scan must never surface ─────────────────────────────
# Comma-separated BASES (SNXX, not SNXX/USDT:USDT). OPTIONAL — the bot blocks
# an untradeable INSTRUMENT CLASS automatically after one rejection, so this
# is only for pre-empting the first attempt or excluding something tradeable.
# Binance's TradFi perps (tokenised equities) share the ticker feed and pass
# the volume and RSI filters like any mover, but entries return -4411 "Please
# sign TradFi-Perps agreement contract fapi" — an account permission. A
# rejection opens no position, so it triggers no cooldown, so the symbol is
# retried every scan forever.
# NOTE: the older BLACKLIST is consulted only by the SPOT engine.
SCAN_EXCLUDE_SYMBOLS=SNXX

# ── Refuse candidates ABOVE this ATR ────────────────────────────────────────
# 0 = OFF (default). A coin can be too FAST to protect, not only too quiet to
# pay for. AKE demo 2026-09-20 had ATR 3.661% and moved 0.38% of PRICE PER
# SECOND after the fill — at 18.6x that is 7% of margin per second, so the
# first stop lands well past its level however fast the guardian polls.
# No reduce-only order can exist before the fill, so this is the only lever
# that reaches it. Enable once there is data on where the line sits.
AUTO_MAX_ATR_PCT=0

# ── Reposition the fixed stop as the peak rises (the "ratchet") ─────────────
# OFF. A resting native trail does the same job tick-by-tick with ONE order,
# instead of a cancel plus a place per step. LSK live 2026-09-20: the ratchet
# exited at +6.64% ROI after five cancel/replace cycles; one native trail at
# the same 3% ROI callback gives +6.89%.
# Each step is also a window where the old stop is gone and the new one is
# unconfirmed — and a placement can return an id without resting.
# true restores the old behaviour.
GUARD_RATCHET_ENABLED=false

# ── Arm the trail at entry ──────────────────────────────────────────────────
# The guardian polls every 2.5s, so ROI can reach +10% and fall back to +2%
# between two polls and the trail never arms — arming was an event it had to
# WITNESS. With this on, the trail is placed at entry with its activationPrice
# at the GUARD_ARM_ROI price, and Binance arms it tick by tick.
# Strictly earlier, never later. False restores arm-on-poll.
GUARD_ARM_AT_ENTRY=true

# ── Arm the trail at entry ──────────────────────────────────────────────────
# The guardian polls every 2.5s, so ROI can reach +10% and fall back to +2%
# between two polls and the trail never arms — arming was an event it had to
# WITNESS. With this on, the trail is placed at entry with its activationPrice
# at the GUARD_ARM_ROI price, and Binance arms it tick by tick.
# Strictly earlier, never later. False restores arm-on-poll.
GUARD_ARM_AT_ENTRY=true

# ── Trailing stop activation ────────────────────────────────────────────────
# A trailing stop sent WITHOUT an activationPrice is not activated at the mark
# price — Binance derives one. WLD 2026-09-18 07:13:47 went on 0.043% short of
# reachable and rested DORMANT, while the adaptive trail was cancelled for it.
# True sends an explicit activationPrice on the already-satisfied side. If the
# exchange refuses it, the placement retries WITHOUT one, which is the old
# behaviour — so this can never leave less protection than before.
GUARD_TRAIL_ACTIVATE_NOW=true
# How far past the mark the activation sits, as a price %.
GUARD_TRAIL_ACTIVATION_EPS_PCT=0.3

# Set to "false" to switch to live trading (defaults to "true" = testnet)
TESTNET=true

# Testnet credentials (https://testnet.binance.vision)
BINANCE_API_KEY_TEST=your_testnet_api_key_here
BINANCE_API_SECRET_TEST=your_testnet_api_secret_here

# Live credentials (Binance → Profile → API Management)
# Permissions needed: Spot & Margin trading. Disable: Withdrawals.
# Whitelist your VPS IP address before enabling live trading.
BINANCE_API_KEY_LIVE=your_live_api_key_here
BINANCE_API_SECRET_LIVE=your_live_api_secret_here

# ── Trading hours (UTC) ─────────────────────────────────────────────────────
# Restrict new entries to specific hours. Leave empty for unrestricted trading.
# Open positions continue to be managed outside trading hours.
# Supports overnight windows e.g. 22:00 to 06:00
# TRADING_HOURS_START=08:00
# TRADING_HOURS_END=20:00

# ── Proxy / VPN ────────────────────────────────────────────────────────────
# Route ccxt traffic through a SOCKS5 proxy to bypass geo-restrictions.
# Production: gluetun sidecar handles this automatically via docker-compose.
# Local testing: ssh -D 1080 -N user@your-vps → set SOCKS_PROXY=socks5h://localhost:1080
# Leave empty for direct connection (testnet, unrestricted regions).
SOCKS_PROXY=socks5h://gluetun:1080

# ProtonVPN WireGuard credentials for gluetun
# Get from: https://account.proton.me/vpn/wireguard
# Create a WireGuard certificate and copy the PrivateKey value
WIREGUARD_PRIVATE_KEY=your_wireguard_private_key_here
SERVER_COUNTRIES=Switzerland

# ── Cooldown ───────────────────────────────────────────────────────────────
# Candles to wait before re-entering a symbol you manually closed.
# Default 3 candles = 15min on 5m. Prevents immediate re-entry after manual close.
MANUAL_CLOSE_COOLDOWN_CANDLES=3

# ── Logging ────────────────────────────────────────────────────────────────
# INFO (default): trades, cycle summaries, errors
# DEBUG: shows why each candidate was rejected (entry filter detail, qty skips, OCO checks)
LOG_LEVEL=INFO

# ── Strategy parameters (all optional — defaults shown) ────────────────────
TIMEFRAME=5m
MAX_SYMBOLS=20
MIN_VOLUME_USDT=5000000
MAX_SPREAD_PCT=0.08

# Entry filters
ADX_MIN=25
RSI_MIN=50
RSI_MAX=65

# Risk & exits
TRAILING_STOP_PCT=0.8
# Seed value for the trailing-stop activation threshold (UI-toggled, in-memory).
# This sets the default percentage only — the feature is turned on/off from the
# dashboard Controls panel. When active, a new position's trailing stop stays
# dormant until price first reaches entry*(1+this%); until then the server-side
# stop-market is the sole protection. Helps avoid whipsaw exits right after entry.
TRAILING_ACTIVATION_PCT=1.0

# ── BTC market-regime filter (UI-toggled, in-memory) ────────────────────────
# These set default VALUES only — the filter is enabled/disabled from the
# dashboard Controls panel. When active, new entries are paused if BTC's price
# has fallen more than BTC_TREND_THRESHOLD_PCT over the last BTC_TREND_LOOKBACK
# candles. Open positions are never affected. The BTC regime is logged on every
# trade regardless of whether the filter is enforced, so you can correlate
# win-rate against BTC trend before turning it on.
BTC_TREND_LOOKBACK=3
BTC_TREND_THRESHOLD_PCT=0.15

# ── Entry-timing gate (per-coin, UI-toggled, DEFAULT ON) ────────────────────
# Targets whipsaw: avoids entering a coin that has spiked above its short-term
# mean. Only enters when price is within ENTRY_TIMING_BAND_PCT above the fast
# EMA (length ENTRY_TIMING_EMA_LEN). Default ON. The fast-EMA distance is logged
# on every entry so you can analyse whether extended entries lose more.
ENTRY_TIMING_EMA_LEN=9
ENTRY_TIMING_BAND_PCT=0.8

# ── Momentum confirmation (per-coin short-term direction, DEFAULT ON) ───────
# Confirms a coin is rising RIGHT NOW at entry rather than merely in a recent
# uptrend structure (which lagging EMA/RSI/ADX can still show during a decline).
# Uses raw-price slope (no smoothing) over the last MOMENTUM_LOOKBACK candles;
# requires the rise to exceed MOMENTUM_MIN_SLOPE_PCT and the last candle to be
# green. The slope is logged on every entry for analysis.
MOMENTUM_LOOKBACK=2
MOMENTUM_MIN_SLOPE_PCT=0.1

# ── Profit lock (continuous, peak-tracking, DEFAULT ON) ─────────────────────
# Once a position's P&L crosses PROFIT_LOCK_ARM_PCT, a profit floor arms and
# ratchets up with the peak P&L, locking a rising fraction of the gain. The
# give-back (peak minus floor) starts at PROFIT_LOCK_GIVEBACK_PCT at the arm
# point and shrinks as the peak climbs (big winners locked ~99%, small winners
# keep a little room). Sits alongside the trailing stop; exits at whichever
# triggers first. Locks scalping gains the looser trailing stop would give back.
PROFIT_LOCK_ARM_PCT=0.6
PROFIT_LOCK_GIVEBACK_PCT=0.12

# ── Fast peak/exit monitor ──────────────────────────────────────────────────
# How often (seconds) the engine fetches the live price for each open position
# to ratchet peak P&L and check the trailing stop / profit lock, independent of
# the main trading cycle. Lower = more responsive (captures fast spikes the way
# the dashboard does) but more API calls. Default 7s.
MONITOR_INTERVAL=7.0

# ── Hard stop-loss ──────────────────────────────────────────────────────────
# Cut a losing position at a fixed P&L (e.g. -0.5%) instead of waiting for the
# trailing stop. The downside mirror of the profit lock. Checked first, and
# regardless of trailing-active state.
HARD_STOP_ENABLED=true
HARD_STOP_PCT=0.5

# ── Smart re-entry guard ────────────────────────────────────────────────────
# After a RED close on a coin, refuse to re-enter it at a price higher than the
# loss exit — stops the bot chasing a just-lost coin back up into the same move.
REENTRY_GUARD_ENABLED=true
# Set to false to disable take profit and let the trailing stop be the sole exit.
# Allows winners to run indefinitely — trailing stop locks in gains as price rises.
TAKE_PROFIT_ENABLED=true
TAKE_PROFIT_PCT=1.5
MAX_OPEN_POSITIONS=3
MAX_HOLD_CANDLES=12
RISK_PER_TRADE_PCT=1.0
MAX_PORTFOLIO_PCT=30.0
MIN_TRADE_USDT=11.0

# Loop interval in seconds (≥ candle close time to avoid re-entering)
POLL_INTERVAL=60
# Drop the still-forming last candle so entry logic reads only CLOSED candles.
# Essential for pullback good-price/RSI-rising gates. Default on.
DROP_INCOMPLETE_CANDLE=true

# Comma-separated symbols to never trade
# Exclude: failed coins, stablecoins, and any coin whose price causes qty to round to 0
BLACKLIST=LUNA/USDT,UST/USDT,FDUSD/USDT,USDC/USDT,EUR/USDT,USD1/USDT,RLUSD/USDT,GENIUS/USDT


# ── Strategy profiles ───────────────────────────────────────────────────────
# Uncomment one profile block at a time. Profile A is the default.

# Profile A — Conservative (default)
# High-liquidity coins only (BTC, ETH, SOL, BNB, XRP etc).
# Stricter trend confirmation means fewer but higher-quality entries.
# Best for: preserving capital while generating steady small gains.
TIMEFRAME=5m
MAX_SYMBOLS=20
MIN_VOLUME_USDT=5000000
MAX_SPREAD_PCT=0.08
ADX_MIN=28
RSI_MIN=52
RSI_MAX=62
TRAILING_STOP_PCT=0.8
# Seed value for the trailing-stop activation threshold (UI-toggled, in-memory).
# This sets the default percentage only — the feature is turned on/off from the
# dashboard Controls panel. When active, a new position's trailing stop stays
# dormant until price first reaches entry*(1+this%); until then the server-side
# stop-market is the sole protection. Helps avoid whipsaw exits right after entry.
TRAILING_ACTIVATION_PCT=1.0

# ── BTC market-regime filter (UI-toggled, in-memory) ────────────────────────
# These set default VALUES only — the filter is enabled/disabled from the
# dashboard Controls panel. When active, new entries are paused if BTC's price
# has fallen more than BTC_TREND_THRESHOLD_PCT over the last BTC_TREND_LOOKBACK
# candles. Open positions are never affected. The BTC regime is logged on every
# trade regardless of whether the filter is enforced, so you can correlate
# win-rate against BTC trend before turning it on.
BTC_TREND_LOOKBACK=3
BTC_TREND_THRESHOLD_PCT=0.15

# ── Entry-timing gate (per-coin, UI-toggled, DEFAULT ON) ────────────────────
# Targets whipsaw: avoids entering a coin that has spiked above its short-term
# mean. Only enters when price is within ENTRY_TIMING_BAND_PCT above the fast
# EMA (length ENTRY_TIMING_EMA_LEN). Default ON. The fast-EMA distance is logged
# on every entry so you can analyse whether extended entries lose more.
ENTRY_TIMING_EMA_LEN=9
ENTRY_TIMING_BAND_PCT=0.8

# ── Momentum confirmation (per-coin short-term direction, DEFAULT ON) ───────
# Confirms a coin is rising RIGHT NOW at entry rather than merely in a recent
# uptrend structure (which lagging EMA/RSI/ADX can still show during a decline).
# Uses raw-price slope (no smoothing) over the last MOMENTUM_LOOKBACK candles;
# requires the rise to exceed MOMENTUM_MIN_SLOPE_PCT and the last candle to be
# green. The slope is logged on every entry for analysis.
MOMENTUM_LOOKBACK=2
MOMENTUM_MIN_SLOPE_PCT=0.1

# ── Profit lock (continuous, peak-tracking, DEFAULT ON) ─────────────────────
# Once a position's P&L crosses PROFIT_LOCK_ARM_PCT, a profit floor arms and
# ratchets up with the peak P&L, locking a rising fraction of the gain. The
# give-back (peak minus floor) starts at PROFIT_LOCK_GIVEBACK_PCT at the arm
# point and shrinks as the peak climbs (big winners locked ~99%, small winners
# keep a little room). Sits alongside the trailing stop; exits at whichever
# triggers first. Locks scalping gains the looser trailing stop would give back.
PROFIT_LOCK_ARM_PCT=0.6
PROFIT_LOCK_GIVEBACK_PCT=0.12

# ── Fast peak/exit monitor ──────────────────────────────────────────────────
# How often (seconds) the engine fetches the live price for each open position
# to ratchet peak P&L and check the trailing stop / profit lock, independent of
# the main trading cycle. Lower = more responsive (captures fast spikes the way
# the dashboard does) but more API calls. Default 7s.
MONITOR_INTERVAL=7.0

# ── Hard stop-loss ──────────────────────────────────────────────────────────
# Cut a losing position at a fixed P&L (e.g. -0.5%) instead of waiting for the
# trailing stop. The downside mirror of the profit lock. Checked first, and
# regardless of trailing-active state.
HARD_STOP_ENABLED=true
HARD_STOP_PCT=0.5

# ── Smart re-entry guard ────────────────────────────────────────────────────
# After a RED close on a coin, refuse to re-enter it at a price higher than the
# loss exit — stops the bot chasing a just-lost coin back up into the same move.
REENTRY_GUARD_ENABLED=true
# Set to false to disable take profit and let the trailing stop be the sole exit.
# Allows winners to run indefinitely — trailing stop locks in gains as price rises.
TAKE_PROFIT_ENABLED=true
TAKE_PROFIT_PCT=1.2
MAX_OPEN_POSITIONS=3
MAX_HOLD_CANDLES=12
RISK_PER_TRADE_PCT=1.0
MAX_PORTFOLIO_PCT=25.0
MIN_TRADE_USDT=11.0

# Profile B — Mid-cap momentum
# Opens the universe to mid-caps (XLM, INJ, STG etc).
# Compensates for lower liquidity with stricter trend filters and wider stops.
# Best for: larger gains per trade at the cost of higher individual coin risk.
# Note: coins showing >15% 24h gain are still filtered by RSI (they'll be overbought).
#TIMEFRAME=5m
#MAX_SYMBOLS=30
#MIN_VOLUME_USDT=1000000
#MAX_SPREAD_PCT=0.15
#ADX_MIN=30
#RSI_MIN=52
#RSI_MAX=62
#TRAILING_STOP_PCT=1.2
#TAKE_PROFIT_PCT=2.0
#MAX_OPEN_POSITIONS=3
#MAX_HOLD_CANDLES=16
#RISK_PER_TRADE_PCT=0.8
#MAX_PORTFOLIO_PCT=20.0
#MIN_TRADE_USDT=11.0

# ── Server-side backstops ────────────────────────────────────────────────────
# OCO (One-Cancels-Other): preferred, fires take-profit + stop-loss server-side
OCO_ENABLED=true
OCO_STOP_PCT=2.0

# Stop-limit fallback for pairs that don't support OCO (e.g. NEAR, FET, ALLO)
# Trigger = entry * (1 - (TRAILING_STOP_PCT + STOP_LIMIT_OFFSET_PCT))
# Fires just below the trailing stop — only triggers if the bot dies mid-trade
# Default offset of 0.05% means trailing=1.2% → stop-limit triggers at 1.25%
STOP_LIMIT_OFFSET_PCT=0.05
# Limit price buffer below stop trigger — ensures fill during fast drops
STOP_LIMIT_FILL_BUFFER_PCT=0.1


# ══ STRATEGY SELECTION ══════════════════════════════════════════════════════
# breakout (default) = five-filter continuation. pullback = gainer/dipper scalp.
STRATEGY=breakout

# ── Pullback strategy (only used when STRATEGY=pullback) ─────────────────────
TIMEFRAME=3m
# Strict gates (trusted — do not loosen):
PB_EMA_FAST=9
PB_EMA_SLOW=21
PB_EMA_BUFFER_PCT=0.05
PB_RSI_MIN=55
PB_RSI_MAX=72
PB_RSI_RISING_LOOKBACK=3
PB_VOL_FLOOR_PCT=40
PB_VOL_MA_LEN=5  # window for the volume MA used by the floor veto
# Good-price gate:
PB_CANDLE_POS_MAX=0.90  # high backstop only; upper-wick veto is the primary good-price filter
PB_UPPER_WICK_MAX=0.40
# Tunable knobs (loosen on testnet for data flow):
PB_LOW_PROXIMITY_PCT=3.0
PB_MAX_WICK_STOP_PCT=1.5
PB_MIN_VOLUME_USDT=10000000
# Regimes:
PB_GAINER_ENABLED=true
PB_DIPPER_ENABLED=true
# Exits (reuse shared trailing/profit-lock engine; these are pullback-specific):
PB_TIMEOUT_CANDLES=5
PB_PRICE_MA_LEN=10
# Position sizing: fixed fraction of portfolio per pullback position (keeps scalps
# modest so several can run). risk_per_trade acts as an upper bound with a floored
# stop distance so tiny wick-stops cannot inflate size.
# 0 = auto-derive per-position size as 100/MAX_OPEN_POSITIONS (even full deployment).
# e.g. MAX_OPEN_POSITIONS=4 → 25% each. Set a positive value to override.
PB_POSITION_PCT=0
PB_SIZING_STOP_FLOOR_PCT=0.5
# NOTE: if the derived share exceeds MAX_PORTFOLIO_PCT, the share is HONORED (not
# clipped) and a warning is logged once. Raise MAX_PORTFOLIO_PCT to match your
# intended deployment (e.g. 25 for 4 positions) to silence it.
# Session windows (UTC+offset). Empty = always active.
PB_SESSION_WINDOWS=23:00-23:15,04:00-06:00,11:00-13:00,15:00-17:00
PB_SESSION_TZ_OFFSET=3
# State isolation (set per-instance so containers don't share positions.json):
STATE_PATH=/app/state/positions.json

# ── Shadow decision log (bot/shadow_decision.py) ────────────────────────────
# Per JEV-BRIEF.md: for every AUTO-ENTRY candidate — entered OR refused — ask
# jev an advisory ENTER/SKIP verdict and log it to SHADOW_PATH, BEFORE the
# trade's outcome is known. Never gates, sizes or delays anything. Read via
# GET /api/shadow (auth required, same as every other /api/* route).
#
# Today jev sees only indicator/scanner structure — no order book, spread or
# liquidity data flows through this codebase yet (investigated 2026-09-19,
# see JEV-BRIEF.md §7) — so this measures a narrower hypothesis than the
# brief's ultimate one. logs/shadow_decisions.jsonl records that honestly on
# every row (inputs_seen.order_book == "UNAVAILABLE").
#
# OFF by default: needs TYPESAFE_API_KEY and `pip install typesafe-sdk`.
# Fires roughly once per candidate the auto-loop resolves — most cycles, most
# candidates are refused, so watch the request volume before assuming the
# cost is acceptable long-term.
# jev is asked FOUR ATOMIC questions (conviction, looks_exhausted,
# regime_aligned, structure_intact). The ENTER/SKIP verdict is composed in
# CODE from weights in bot/shadow_decision.py, NOT asked of the model — so a
# change of priorities is a coefficient edit, and every component is recorded
# raw so the weights can be re-fitted offline against outcomes.
SHADOW_ENABLED=false
TYPESAFE_API_KEY=
# "jev" alone is the model FAMILY and is rejected — 400 "Unknown model: jev".
# Both names the API offers are FLOATING aliases, so there is nothing to pin:
#   jev-latest   — current general model (the SDK's own default)
#   jev-preview  — preview channel; do not use for measurement runs
# The alias floats, but the API RESOLVES it server-side and the response
# carries the concrete version (e.g. jev-1.13.0), which is what each row's
# `model` records. So provenance is exact without pinning anything.
SHADOW_MODEL=jev-latest
SHADOW_PATH=logs/shadow_decisions.jsonl
# Ceiling on jev calls per minute from the shadow logger specifically,
# independent of how often the bot itself actually enters. Excess candidates
# in a busy cycle are simply not judged that cycle — never queued, never
# blocks the loop.
SHADOW_MAX_PER_MINUTE=30

